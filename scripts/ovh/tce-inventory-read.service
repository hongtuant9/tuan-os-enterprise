[Unit]
Description=TCE KiotViet Inventory read-only refresh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/tuan-ai/tce-control-center/scripts/ovh/tce-read-worker-call.sh inventory
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
