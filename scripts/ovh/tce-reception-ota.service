[Unit]
Description=TCE AI Receptionist OTA email collector refresh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/tuan-ai/tce-control-center/scripts/ovh/tce-read-worker-call.sh reception-ota
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
