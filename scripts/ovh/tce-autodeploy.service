[Unit]
Description=TCE GitHub main -> OVH production deploy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=APP_ROOT=/opt/tuan-ai/tce-control-center
Environment=ENV_FILE=/opt/tuan-ai/secrets/tce-app.env
Environment=STATE_DIR=/opt/tuan-ai/deploy-state
ExecStart=/opt/tuan-ai/tce-control-center/scripts/ovh/autodeploy.sh
TimeoutStartSec=1800
